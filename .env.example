# Artispreneur Directory - Environment Variables
# Copy this to .env.local and fill in your values

# AWS Cognito (artispreneur-agent pool)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id-here

# AWS API Gateway (artispreneur-directory-api)
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Optional site URL
# NEXT_PUBLIC_SITE_URL=https://directory.artispreneur.com
